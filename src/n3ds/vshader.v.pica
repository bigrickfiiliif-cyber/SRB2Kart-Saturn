; SRB2Kart Saturn - Nintendo 3DS GPU renderer
; Vertex shader for the PICA200: transforms FOutVector (x, y, z, s, t) by the
; combined projection * modelview matrix (already tilted for the rotated 3DS
; screen and remapped to PICA depth range on the CPU) and passes the texture
; coordinates through. Per-polygon colour comes from the TEV constant colour.

.fvec projection[4]

.constf consts(0.0, 1.0, 0.0, 0.0)
.alias  ones consts.yyyy

.out outpos position
.out outtc0 texcoord0

.alias inpos v0
.alias intc0 v1

.proc main
	mov r0.xyz, inpos
	mov r0.w,   ones

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	mov outtc0, intc0
	end
.end
